{
  "name": "agentswarm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "test": "node --test test/*.test.mjs",
    "smoke": "powershell -ExecutionPolicy Bypass -File ../scripts/smoke.ps1",
