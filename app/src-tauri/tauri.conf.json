{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentSwarm",
  "version": "0.1.0",
  "identifier": "dev.vaishak.agentswarm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AgentSwarm",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"]
  }
}
